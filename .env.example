# Recall configuration. Copy to `.env` and uncomment what you need. `docker compose` loads it
# automatically; for a local run use `node --env-file=.env packages/server/dist/main.js`. Every line is optional: with no provider key Recall runs fully offline on a
# mock LLM, which is enough to try the API but gives canned answers.
#
# Do not leave a variable set to an empty value; leave it commented out instead.

# ---- Server -----------------------------------------------------------------------------------
# RECALL_PORT=8000
# RECALL_HOST=0.0.0.0
# RECALL_LOG_LEVEL=info              # fatal | error | warn | info | debug | trace | silent
# RECALL_PUBLIC_URL=https://memory.example.com

# ---- Database ---------------------------------------------------------------------------------
# Unset: embedded Postgres (PGlite) stored in RECALL_DATA_DIR. Fine for one process.
# Set: any Postgres 16+ with the pgvector extension (docker compose sets this for you).
# RECALL_DATABASE_URL=postgres://user:password@host:5432/recall
# RECALL_DATA_DIR=./.recall        # use "memory" for a throwaway in-memory database
# POSTGRES_PASSWORD=recall           # docker compose only: password of the bundled Postgres

# ---- Authentication ---------------------------------------------------------------------------
# Off by default so the quickstart needs no token. Turn it on for anything reachable by others.
# Clients then send `Authorization: Bearer <jwt>`: tokens scoped to a workspace, peer or session,
# minted with `recall token` (the server's command line).
# RECALL_AUTH_ENABLED=true
# RECALL_AUTH_SECRET=change-me-to-a-long-random-string

# ---- Hosted mode (multi-tenant: accounts, customer API keys, operator control plane) ----------
# RECALL_HOSTED=true                 # refuses to start without auth, an admin token and Postgres
# RECALL_ADMIN_TOKEN=                # operator control plane /admin/v1 (>= 24 chars); off when unset
# RECALL_KEY_RATE_LIMIT=600          # default requests/minute per API key (per process)
# RECALL_KEY_CACHE_TTL_MS=5000       # a revoked key stops working within this time
# RECALL_BUDGET_CACHE_TTL_MS=15000   # how often an account's month-to-date spend is re-read
# RECALL_BUDGET_RETRY_MS=300000      # paused (over-budget) background jobs retry after this
# RECALL_DATABASE_POOL_MAX=20        # connections per process
# RECALL_DATABASE_CA=                # PEM CA to verify Postgres TLS (e.g. Supabase's certificate)
# RECALL_METRICS_TOKEN=              # bearer token for GET /metrics (required for it in hosted mode)

# ---- Hosted sign-up, dashboard (/app) and prepaid billing (hosted mode only) -------------------
# RECALL_PUBLIC_URL=https://api.example.com   # required with billing (magic links, Checkout URLs)
# RECALL_SIGNUP_ENABLED=                # default: on when Stripe is configured, off otherwise
# RECALL_SESSION_SECRET=                # >= 32 chars; dashboard cookies/CSRF (default: from AUTH_SECRET)
# RECALL_SESSION_TTL_DAYS=30
# RESEND_API_KEY=                         # magic-link email; without it the link is logged (dev)
# RECALL_EMAIL_FROM="Recall <login@mail.example.com>"
# STRIPE_SECRET_KEY=                      # billing is on with RECALL_HOSTED=true and both Stripe vars
# STRIPE_WEBHOOK_SECRET=                  # endpoint: POST /billing/stripe/webhook
# STRIPE_PORTAL_CONFIGURATION=            # optional bpc_... customer-portal configuration
# RECALL_STRIPE_INVOICES=true           # Checkout issues an invoice per top-up
# Customer prices in USD (the defaults are the hosted service's list prices).
# RECALL_PRICE_INGEST_PER_MTOK_USD=1.75
# RECALL_PRICE_STORE_PER_MTOK_USD=0.25  # messages no reasoning call reads, facts added via the API
# RECALL_PRICE_CHAT_MINIMAL_USD=0.0008
# RECALL_PRICE_CHAT_LOW_USD=0.005
# RECALL_PRICE_CHAT_MEDIUM_USD=0.025
# RECALL_PRICE_CHAT_HIGH_USD=0.05
# RECALL_PRICE_CHAT_MAX_USD=0.25
# RECALL_SIGNUP_CREDIT_USD=5            # free credit per new self-serve account
# RECALL_SIGNUP_CREDIT_PER_IP=1         # welcome credits per client network (IPv4 / IPv6 /64) in 30 days, 0 = no limit
# RECALL_SIGNUP_CREDIT_DAILY_CAP_USD=250 # most welcome credit granted per UTC day in total (later sign-ups get theirs the next day), 0 = no cap
# "Continue with GitHub" on the sign-in page: a GitHub OAuth app (github.com/settings/developers)
# with callback URL <dashboard>/auth/github/callback. Set both, or neither.
# RECALL_GITHUB_CLIENT_ID=
# RECALL_GITHUB_CLIENT_SECRET=
# RECALL_SIGNUP_BLOCKED_DOMAINS=        # extra email domains refused for new sign-ups (comma-separated, subdomains too);
#                                       # ~60 disposable domains are always blocked, existing users can still sign in
# RECALL_OPERATOR_EMAILS=               # dashboard users who may open the operator console at /app/admin (comma-separated)
# Website analytics on the console's Traffic page, read from a self-hosted Umami server. Set all three.
# UMAMI_URL=                            # e.g. https://stats.example.com
# UMAMI_WEBSITE_ID=                     # the website's id in Umami (a UUID)
# UMAMI_API_KEY=                        # Umami: Settings → API keys
# RECALL_FUNNEL_REPORT_ENABLED=true     # weekly activation-funnel email, Mondays from 08:00 Europe/Amsterdam, to
#                                       # RECALL_ALERT_EMAIL (else to RECALL_OPERATOR_EMAILS); false turns it off
# RECALL_ONBOARDING_EMAILS_ENABLED=true # welcome email to new self-serve accounts, and one reminder after 48 hours
#                                       # if still unused (needs RESEND_API_KEY); false turns them off
# RECALL_TOPUP_AMOUNTS_USD=10,25,50,100
# RECALL_TOPUP_MIN_USD=5
# RECALL_TOPUP_MAX_USD=1000

# ---- LLM providers: set one or more keys; Recall picks the cheapest model per task ----------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Own key and budget for benchmark accounts (account metadata llm_key: "eval"):
# OPENROUTER_API_KEY_EVAL=
# OpenRouter routing per task (JSON; see https://recallmem.dev/docs#openrouter). Hosted mode always sends
# data_collection "deny" and refuses ":free" models unless RECALL_OPENROUTER_ALLOW_FREE=true.
# RECALL_OPENROUTER_ROUTING={"default":{"sort":"price","data_collection":"deny"},"reasoner":{"fallbacks":["qwen/qwen3.5-9b"]}}
# An OpenRouter model that answers when an answer model's own vendor is down or refuses the call
# (added as a fallback to every chat level routed through OpenRouter, unless the routing above
# already sets fallbacks):
# RECALL_ANSWER_FALLBACK=openai/gpt-5-mini
# RECALL_OPENROUTER_ALLOW_FREE=false
# RECALL_OPENROUTER_LIVE_PRICES=true   # price unlisted openrouter/* models from openrouter.ai/api/v1/models
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# Open-weight hosts, used through RECALL_MODEL_* only (e.g. a fine-tuned model on a dedicated
# endpoint): "together/<model>", "together-dedicated/<project>/<endpoint>",
# "fireworks/accounts/<account>/models/<model>".
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# Any OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp...). Refer to its models as
# "compat/<model-name>" in the RECALL_MODEL_* settings below.
# RECALL_COMPAT_BASE_URL=http://host.docker.internal:11434/v1
# RECALL_COMPAT_API_KEY=
# Pin one provider when several keys are set:
# RECALL_DEFAULT_PROVIDER=anthropic  # anthropic | openai | gemini

# ---- Per-task model routing (format: provider/model) ------------------------------------------
# Unset tasks use the cheapest suitable model of the configured providers. Bulk background work
# (reasoner, summary, card, dream) can run on a small model while hard chat levels use a bigger one.
# RECALL_MODEL_REASONER=gemini/gemini-2.5-flash-lite
# RECALL_MODEL_SUMMARY=gemini/gemini-2.5-flash-lite
# RECALL_MODEL_CARD=gemini/gemini-2.5-flash-lite
# RECALL_MODEL_DREAM=openai/gpt-5-mini
# RECALL_MODEL_CHAT_MINIMAL=gemini/gemini-2.5-flash-lite
# RECALL_MODEL_CHAT_LOW=openai/gpt-5-mini
# RECALL_MODEL_CHAT_MEDIUM=openai/gpt-5-mini
# RECALL_MODEL_CHAT_HIGH=openai/gpt-5.5
# RECALL_MODEL_CHAT_MAX=openai/gpt-6.1-sol
# Embeddings. Keep the same model for the lifetime of a database.
# RECALL_EMBEDDING_MODEL=openai/text-embedding-3-large   # reduced to RECALL_EMBEDDING_DIMENSIONS
# RECALL_EMBEDDING_DIMENSIONS=1536
# Override or add per-million-token prices (USD) used for cost metering:
# RECALL_PRICING_JSON={"compat/qwen3-8b":{"input":0,"output":0}}

# ---- Background processing --------------------------------------------------------------------
# RECALL_ROLE=all                    # all | api | worker (split API and workers when scaling out)
# RECALL_WORKER_CONCURRENCY=4
# RECALL_REASONER_BATCH_TOKENS=1200  # extract once this many unprocessed tokens pile up in a session...
# RECALL_REASONER_MAX_DELAY_MS=15000 # ...or the oldest unprocessed message is this old...
# RECALL_REASONER_IDLE_MS=5000       # ...or no new message arrived in the session for this long
# RECALL_DREAMS_ENABLED=true
# RECALL_SUMMARIES_ENABLED=true
# RECALL_CHAT_CACHE_TTL_S=300

# ---- Webhooks ---------------------------------------------------------------------------------
# Events are only delivered when a signing secret is set (HMAC-SHA256 of the body, X-Recall-Signature).
# RECALL_WEBHOOK_SECRET=

# ---- Tuning (defaults shown; most deployments never change these) ------------------------------
# RECALL_CORS_ORIGINS=                         # comma-separated browser origins allowed to call the API; unset = any
# RECALL_DATABASE_STATEMENT_TIMEOUT_MS=60000   # longest one SQL statement may run, 0 = no limit
# RECALL_KEY_CHAT_RATE_LIMIT=60                # chat requests per minute per API key, 0 = off
# RECALL_AUTH_FAILURE_LIMIT=30                 # failed credentials per minute per client network before 429s, 0 = off
# RECALL_WORKER_POLL_MS=1000                   # how often an idle worker looks for jobs
# RECALL_WORKER_LEASE_MS=120000                # a claimed job's lease (extended while it runs)
# RECALL_WORKER_RETRY_BASE_MS=2000             # first retry delay, doubling per attempt (max 10 minutes)
# RECALL_QUEUE_MAX_ATTEMPTS=5                  # attempts before a job is marked failed
# RECALL_REASONER_ENABLED=true                 # learn facts from new messages
# RECALL_REASONER_WINDOW_TOKENS=4000           # largest transcript window per extraction call
# RECALL_DREAM_MIN_NEW_CONCLUSIONS=50          # night shift: new facts in a collection before one is scheduled,
# RECALL_DREAM_IDLE_MS=600000                  #   once the collection has been quiet this long,
# RECALL_DREAM_MIN_INTERVAL_MS=3600000         #   and at least this long after the previous one
# RECALL_WEBHOOKS_ENABLED=true                 # deliver outgoing webhooks
# RECALL_WEBHOOK_ALLOW_PRIVATE=false           # allow webhook URLs on private/loopback addresses (local development only)
# RECALL_PRICE_INGEST_MIN_TOKENS=50            # hosted billing: minimum billed tokens per message

# ---- Benchmark harness (evals/) ---------------------------------------------------------------
# The harness reads the same provider keys above for its judge, plus:
# EVAL_TARGET_URL=http://localhost:8000
# EVAL_API_KEY=
# EVAL_JUDGE_MODEL=openai/gpt-4.1
