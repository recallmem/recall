{
  "name": "@recall-memory/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for Recall, the reasoning-memory service for AI agents. Speaks the v3 memory REST API.",
  "keywords": [
    "agents",
    "memory",
    "llm",
    "mcp",
    "recall"
  ],
  "license": "MIT",
  "homepage": "https://recallmem.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recallmem/recall.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/recallmem/recall/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.4",
    "@types/node": "^22.20.5",
    "hono": "^4.13.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
