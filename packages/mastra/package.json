{
  "name": "@recall-memory/mastra",
  "version": "0.1.0",
  "description": "Recall memory for Mastra agents: a processor that adds what Recall knows about the user to each run and stores every turn, and tools the agent can call.",
  "keywords": [
    "mastra",
    "agents",
    "memory",
    "processor",
    "llm",
    "recall"
  ],
  "license": "MIT",
  "homepage": "https://recallmem.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recallmem/recall.git",
    "directory": "packages/mastra"
  },
  "bugs": {
    "url": "https://github.com/recallmem/recall/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@recall-memory/sdk": "workspace:^"
  },
  "peerDependencies": {
    "@mastra/core": "^1.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.76.0",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  }
}
