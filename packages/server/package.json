{
  "name": "@recall-memory/server",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "recall-server": "dist/main.js",
    "recall": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.4",
    "gpt-tokenizer": "^4.0.0",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "openai": "^7.30.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "stripe": "22.6.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
