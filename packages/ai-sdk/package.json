{
  "name": "@recall-memory/ai-sdk",
  "version": "0.1.0",
  "description": "Recall memory for the Vercel AI SDK: tools the model can call, and middleware that adds what Recall knows about the user to each request and stores every turn.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "agents",
    "memory",
    "llm",
    "recall"
  ],
  "license": "MIT",
  "homepage": "https://recallmem.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recallmem/recall.git",
    "directory": "packages/ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/recallmem/recall/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@recall-memory/sdk": "workspace:^"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ai": "^7.0.138",
    "typescript": "7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  }
}
