{
  "mcpServers": {
    "recall": {
      "command": "node",
      "args": ["./scripts/mcp-bridge.mjs"],
      "cwd": ".",
      "env_vars": [
        "RECALL_URL",
        "RECALL_API_KEY",
        "RECALL_WORKSPACE_ID",
        "RECALL_PEER_ID",
        "RECALL_MCP_PROFILE",
        "RECALL_CONFIG_PATH",
        "RECALL_MCP_TIMEOUT_MS"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 150
    }
  }
}
